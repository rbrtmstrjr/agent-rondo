                  {
                      "parameters":  {
                                         "jsCode":  "// Get raw text from Gemini Message a Model node\nconst rawText = $json?.content?.parts?.[0]?.text || \u0027\u0027;\n\n// All required section headers (must match LLM exactly)\nconst HEADERS = [\n  \u0027FRAME_1_IMAGE_PROMPT\u0027,\n  \u0027FRAME_2_IMAGE_EDIT_PROMPT\u0027,\n  \u0027FRAME_3_IMAGE_EDIT_PROMPT\u0027,\n  \u0027VEO_VIDEO_PROMPT_CLEANUP\u0027,\n  \u0027VEO_VIDEO_PROMPT_ENJOYMENT\u0027\n];\n\n// Extract text between headers\nfunction extractSection(text, header) {\n  const start = text.indexOf(header);\n  if (start === -1) return \u0027\u0027;\n\n  const afterStart = start + header.length;\n  let end = text.length;\n\n  for (const h of HEADERS) {\n    if (h === header) continue;\n    const idx = text.indexOf(h, afterStart);\n    if (idx !== -1 \u0026\u0026 idx \u003c end) {\n      end = idx;\n    }\n  }\n\n  return text.substring(afterStart, end).trim();\n}\n\n// Extract all sections\nconst frame1_prompt = extractSection(rawText, \u0027FRAME_1_IMAGE_PROMPT\u0027);\nconst frame2_edit_prompt = extractSection(rawText, \u0027FRAME_2_IMAGE_EDIT_PROMPT\u0027);\nconst frame3_edit_prompt = extractSection(rawText, \u0027FRAME_3_IMAGE_EDIT_PROMPT\u0027);\nconst veo_cleanup_prompt = extractSection(rawText, \u0027VEO_VIDEO_PROMPT_CLEANUP\u0027);\nconst veo_enjoyment_prompt = extractSection(rawText, \u0027VEO_VIDEO_PROMPT_ENJOYMENT\u0027);\n\n// Return structured output\nreturn [\n  {\n    json: {\n      frame1_prompt,\n      frame2_edit_prompt,\n      frame3_edit_prompt,\n      veo_cleanup_prompt,\n      veo_enjoyment_prompt\n    }\n  }\n];\n"
                                     },
