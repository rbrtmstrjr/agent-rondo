                      "parameters":  {
                                         "jsCode":  "// Get the raw LLM text output\nconst rawText =\n  $input.all()[0]?.json?.content?.parts?.[0]?.text || \u0027\u0027;\n\n// Safety check\nif (!rawText) {\n  return [\n    {\n      json: {\n        error: \u0027No LLM text output found\u0027\n      }\n    }\n  ];\n}\n\n// Helper function to extract prompt sections\nfunction extractSection(labelStart, labelEnd) {\n  const startIndex = rawText.indexOf(labelStart);\n  if (startIndex === -1) return \u0027\u0027;\n\n  const endIndex = labelEnd\n    ? rawText.indexOf(labelEnd, startIndex)\n    : rawText.length;\n\n  return rawText\n    .substring(startIndex + labelStart.length, endIndex)\n    .trim();\n}\n\n// Extract each prompt\nconst ruinedPrompt = extractSection(\n  \u0027PROMPT 1 — IMAGE GENERATION PROMPT (RUINED HOUSE)\u0027,\n  \u0027PROMPT 2 — IMAGE EDITING PROMPT\u0027\n);\n\nconst structurePrompt = extractSection(\n  \u0027PROMPT 2 — IMAGE EDITING PROMPT (CLEAN SURROUNDINGS + PURE STRUCTURE)\u0027,\n  \u0027PROMPT 3 — IMAGE EDITING PROMPT\u0027\n);\n\nconst restorePrompt = extractSection(\n  \u0027PROMPT 3 — IMAGE EDITING PROMPT (FULL MODERN HOUSE RESTORATION)\u0027,\n  \u0027PROMPT 4 — IMAGE EDITING PROMPT\u0027\n);\n\nconst landscapePrompt = extractSection(\n  \u0027PROMPT 4 — IMAGE EDITING PROMPT (FINAL LANDSCAPING)\u0027,\n  null\n);\n\n// Return clean, assignable fields\nreturn [\n  {\n    json: {\n      ruined_prompt: ruinedPrompt,\n      structure_prompt: structurePrompt,\n      restore_prompt: restorePrompt,\n      landscape_prompt: landscapePrompt\n    }\n  }\n];\n"
