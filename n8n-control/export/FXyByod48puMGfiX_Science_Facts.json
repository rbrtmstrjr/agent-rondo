                  {
                      "parameters":  {
                                         "jsCode":  "const raw = $json.content.parts[0].text;\n\nconst shortFactMatch = raw.match(/SHORT_FACT:\\s*([\\s\\S]*?)\\n\\nSUPPORTING_CAPTION:/);\nconst captionMatch = raw.match(/SUPPORTING_CAPTION:\\s*([\\s\\S]*?)\\n\\nIMAGE_PROMPT:/);\nconst imagePromptMatch = raw.match(/IMAGE_PROMPT:\\s*([\\s\\S]*)$/);\n\nreturn {\n  short_fact: shortFactMatch ? shortFactMatch[1].trim() : \"\",\n  supporting_caption: captionMatch ? captionMatch[1].trim() : \"\",\n  image_prompt: imagePromptMatch ? imagePromptMatch[1].trim() : \"\"\n};\n"
