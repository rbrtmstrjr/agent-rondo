                  {
                      "parameters":  {
                                         "jsCode":  "// Read raw text output from Prompt Generator\nconst rawText = $input.first().json.content.parts[0].text;\n\n// Parse JSON safely\nlet parsed;\ntry {\n  parsed = JSON.parse(rawText);\n} catch (error) {\n  throw new Error(\"Gemini output is not valid JSON\");\n}\n\n// Validate steps array\nif (!parsed.steps || !Array.isArray(parsed.steps)) {\n  throw new Error(\"Gemini output does not contain a valid steps array\");\n}\n\n// Normalize step numbering (optional but recommended)\nparsed.steps = parsed.steps.map((step, index) =\u003e ({\n  ...step,\n  step_number: index + 1\n}));\n\n// Return clean output for Split Out\nreturn [\n  {\n    json: {\n      steps: parsed.steps\n    }\n  }\n];\n"
                                     },
