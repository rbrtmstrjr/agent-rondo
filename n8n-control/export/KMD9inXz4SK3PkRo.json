                      "id":  "node-reply",
                      "name":  "Generate Reply",
                      "retryOnFail":  true,
                      "maxTries":  3,
                      "waitBetweenTries":  3000,
                      "notes":  "Gemini 2.5 Flash (fast/cheap for chat). Returns JSON { reply, escalate, reason }. Bump to gemini-2.5-pro for richer answers.",
                      "credentials":  {
                                          "googlePalmApi":  {
                                                                "id":  "0eINQFptxG4T1uH7",
                                                                "name":  "epic catch api"
                                                            }
                                      }
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Parse the model\u0027s JSON. On any problem, fail safe -\u003e escalate to a human.\nconst ctx = $(\u0027Setup (KB + Config)\u0027).first().json;\nconst raw = $json.content \u0026\u0026 $json.content.parts \u0026\u0026 $json.content.parts[0] ? $json.content.parts[0].text : \u0027\u0027;\nlet clean = String(raw).trim()\n  .replace(/^```json\\s*/i, \u0027\u0027)\n  .replace(/^```\\s*/, \u0027\u0027)\n  .replace(/```$/, \u0027\u0027)\n  .trim();\nlet data;\ntry { data = JSON.parse(clean); }\ncatch (e) {\n  return [{ json: { psid: ctx.psid, userText: ctx.userText, reply: \u0027\u0027, escalate: true, reason: \u0027Could not parse model output: \u0027 + clean.slice(0, 140) } }];\n}\nconst reply = (data.reply || \u0027\u0027).toString().trim();\nlet escalate = data.escalate === true;\nlet reason = (data.reason || \u0027\u0027).toString().trim();\n// Deterministic human-handoff: ALWAYS escalate if the person asks for a person,\n// regardless of what the model decided (bulletproofs the Human Agent path).\nconst HUMAN_RE = /\\b(human|real person|real human|talk to (?:a |an )?(?:person|agent|someone|representative)|speak to (?:a |an )?(?:person|agent|someone|representative)|live (?:agent|person)|customer service|support agent|representative)\\b/i;\nif (HUMAN_RE.test(ctx.userText || \u0027\u0027)) { escalate = true; reason = reason || \u0027User asked to talk to a human\u0027; }\nif (!escalate \u0026\u0026 !reply) { escalate = true; reason = reason || \u0027Model produced an empty reply\u0027; }\nreturn [{ json: { psid: ctx.psid, userText: ctx.userText, reply, escalate, reason } }];"
                                     },
